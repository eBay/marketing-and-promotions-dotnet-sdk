<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EBay.MarketingAndPromotions</RootNamespace>
    <AssemblyName>EBay.MarketingAndPromotions</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>EBay.MarketingAndPromotions</PackageId>
    <Version>1.0.0</Version>
    <Authors>eBay</Authors>
    <Description>Marketing and Promotions SDK for eBay Marketing and Recommendation APIs</Description>
    <PackageProjectUrl>https://github.com/eBay/marketing-and-promotions-dotnet-sdk</PackageProjectUrl>
    <RepositoryUrl>https://github.com/eBay/marketing-and-promotions-dotnet-sdk</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Kiota.Bundle" Version="1.*" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.*" />
  </ItemGroup>

</Project>
